{
  "expo": {
    "name": "HEvent-mobile",
    "slug": "HEvent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HEvent utilise votre position pour afficher la distance qui vous sépare des événements."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HEvent utilise la caméra pour scanner les QR codes des billets à l’entrée.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
