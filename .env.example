# Adresse de l'API (facultatif) : détectée automatiquement sinon
# - émulateur Android : 10.0.2.2
# - téléphone avec Expo Go : IP du PC qui lance « npx expo start »
EXPO_PUBLIC_API_HOST=
EXPO_PUBLIC_API_PORT=3001
EXPO_PUBLIC_API_PATH=/api/v1

# Clé Google Maps Platform (API « Routes ») pour les distances en voiture (facultatif)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
